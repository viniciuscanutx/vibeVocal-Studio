<UserControl x:Class="VibeVocalStudio.Views.ParameterSlider" x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="0,0,0,8">
        <DockPanel>
            <TextBlock Text="{Binding DisplayValue, ElementName=Root}" DockPanel.Dock="Right" HorizontalAlignment="Right" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding Label, ElementName=Root}"/>
        </DockPanel>
        <Slider Value="{Binding Value, ElementName=Root, Mode=TwoWay}" Minimum="{Binding Minimum, ElementName=Root}"
                Maximum="{Binding Maximum, ElementName=Root}" TickFrequency="{Binding Step, ElementName=Root}"
                SmallChange="{Binding Step, ElementName=Root}" LargeChange="3"
                AutomationProperties.Name="{Binding Label, ElementName=Root}" ToolTip="{Binding Description, ElementName=Root}"/>
    </StackPanel>
</UserControl>
